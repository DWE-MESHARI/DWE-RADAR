rules_version = '2';

// Default rules for "رادار الجودة": open read/write on the analyses collection so the
// dashboard works out of the box for a small internal team with the link to the site.
// This is NOT locked down to specific users — anyone with the site URL can read and
// write. Tighten this before sharing the link outside your team, e.g. by requiring
// Firebase Authentication (see README "تأمين الوصول" section) and replacing `true`
// below with `request.auth != null`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /analyses/{docId} {
      allow read, write: if true;
    }
  }
}
